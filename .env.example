# AWS & LocalStack Configuration
# If LOCALSTACK_ENDPOINT is defined and non-empty, AWS services will connect to LocalStack.
# Unset or set to empty to use real AWS services.
LOCALSTACK_ENDPOINT=http://localstack:4566
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB Configuration
DYNAMODB_REQUESTS_TABLE=share-grant-requests
DYNAMODB_OUTBOX_TABLE=share-grant-outbox

# SQS Configuration
SQS_REQUESTS_QUEUE_NAME=share-grant-requests-queue
SQS_REQUESTS_QUEUE_URL=http://localstack:4566/000000000000/share-grant-requests-queue
SQS_DLQ_NAME=share-grant-requests-dlq
SQS_POLL_WAIT_TIME_SECONDS=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30

# SNS Configuration
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:share-grant-hub-topic

# Controller Service Configuration
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=8000
CONTROLLER_URL=http://controller:8000
CALLBACK_AUTH_TOKEN=secret-callback-token
OUTBOX_PUBLISHER_INTERVAL_SECONDS=2
RECONCILER_INTERVAL_SECONDS=10
RECONCILER_PENDING_THRESHOLD_SECONDS=60

# Databricks Service Configuration
DATABRICKS_USE_MOCK=true
DATABRICKS_HOST=https://dummy-workspace.cloud.databricks.com
DATABRICKS_CLIENT_ID=dummy-client-id
DATABRICKS_CLIENT_SECRET=dummy-client-secret
DATABRICKS_MAX_RETRIES=3
DATABRICKS_RETRY_BACKOFF_SECONDS=1.0

# Logging
LOG_LEVEL=INFO
